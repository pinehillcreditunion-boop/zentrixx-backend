# Copy to .env and add your real credentials.
RESEND_API_KEY=re_your_actual_api_key
RESEND_FROM_EMAIL=Zentrixx <zentrixx@zentrixx.cloud>
DB_STRING=your_mongodb_connection_string
DB_LOCAL=mongodb://127.0.0.1:27017/mobilebank
SECRET_KEY=your_jwt_secret

# Server-side S3 uploads for identity documents and profile photos
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=your_bucket_region
AWS_S3_BUCKET=your_bucket_name
AWS_S3_UPLOAD_DIR=user-uploads
# Optional: CloudFront or public bucket base URL
AWS_S3_PUBLIC_BASE_URL=

# Comma-separated frontend origins allowed by backend CORS
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173,https://zentrixx.cloud,https://www.zentrixx.cloud
# Optional AWS temporary credentials session token
AWS_SESSION_TOKEN=
